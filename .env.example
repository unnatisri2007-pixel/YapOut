# GEMINI_API_KEY: Required for Gemini AI API calls (if enabled)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ==========================================
# GEMMA 4 INFERENCE RUNTIME CONFIGURATION
# ==========================================
# Provide the endpoint URL for your hosted Gemma 4 inference service
# (e.g., vLLM, Ollama, Hugging Face TGI, Vertex AI Model Garden, or custom API).
# If left blank or unset, YapOut operates in clearly labeled Simulated Dev Mode.
GEMMA_4_ENDPOINT_URL=""

# Optional API bearer token or key for the Gemma 4 inference server.
GEMMA_4_API_KEY=""

# Model identifier tag passed to the Gemma 4 inference runtime (defaults to "gemma-4")
GEMMA_4_MODEL_NAME="gemma-4"

# Request timeout in milliseconds (default: 30000)
GEMMA_4_TIMEOUT_MS="30000"

# ==========================================
# ADMINISTRATOR ROLE-BASED ACCESS CONTROL (RBAC)
# ==========================================
# Comma-separated list of email addresses granted administrator privileges
ADMIN_EMAILS="unnatisri2007@gmail.com,admin@yapout.com"

# Secret server key used to securely bootstrap or claim admin privileges
ADMIN_BOOTSTRAP_KEY="yapout-secure-bootstrap-key"
